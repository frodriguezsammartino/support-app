generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  BACKLOG
  IN_PROGRESS
  COMPLETED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  active  Boolean  @default(true)
  tickets Ticket[]
}

model Ticket {
  id             String          @id @default(cuid())
  number         Int             @unique @default(autoincrement())
  reporterName   String
  reporterEmail  String?
  title          String
  description    String
  status         TicketStatus    @default(BACKLOG)
  priority       TicketPriority?
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  comments      Comment[]
  statusHistory TicketStatusHistory[]

  @@index([status])
  @@index([categoryId])
  @@index([reporterEmail])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  isFromAdmin Boolean @default(false)
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketStatusHistory {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus TicketStatus?
  toStatus   TicketStatus
  note       String?
  changedAt  DateTime      @default(now())

  @@index([ticketId])
}

enum MaintenanceScheduleType {
  INTERVAL
  DAILY
  WEEKLY
  MONTHLY_DAY
  MONTHLY_NTH_WEEKDAY
}

model MaintenanceTask {
  id           String                  @id @default(cuid())
  title        String
  description  String?
  scheduleType MaintenanceScheduleType @default(INTERVAL)

  /// Período nominal en horas. Para INTERVAL es la frecuencia real; para los demás
  /// tipos es el período aproximado (24 / 168 / 720) y solo se usa para decidir
  /// con cuánta anticipación una tarea pasa a "vence pronto".
  intervalHours Int

  /// Minutos desde la medianoche, en hora de la clínica. Solo para los tipos de calendario.
  timeOfDay Int?
  /// 0 = domingo .. 6 = sábado. Para WEEKLY y MONTHLY_NTH_WEEKDAY.
  weekday   Int?
  /// 1..31, se recorta al último día del mes cuando no existe. Para MONTHLY_DAY.
  monthDay  Int?
  /// 1..4, o 5 = "el último". Para MONTHLY_NTH_WEEKDAY.
  nthWeek   Int?

  active          Boolean   @default(true)
  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  completions MaintenanceCompletion[]

  @@index([active])
}

model MaintenanceCompletion {
  id          String          @id @default(cuid())
  taskId      String
  task        MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note        String?
  completedAt DateTime        @default(now())

  @@index([taskId])
}
