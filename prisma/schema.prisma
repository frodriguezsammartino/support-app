generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  BACKLOG
  IN_PROGRESS
  COMPLETED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  active  Boolean  @default(true)
  tickets Ticket[]
}

model Ticket {
  id             String          @id @default(cuid())
  number         Int             @unique @default(autoincrement())
  reporterName   String
  reporterEmail  String?
  title          String
  description    String
  status         TicketStatus    @default(BACKLOG)
  priority       TicketPriority?
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  assetId        String?
  asset          Asset?          @relation(fields: [assetId], references: [id])
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  comments      Comment[]
  statusHistory TicketStatusHistory[]

  @@index([status])
  @@index([categoryId])
  @@index([reporterEmail])
  @@index([assetId])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  isFromAdmin Boolean @default(false)
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketStatusHistory {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus TicketStatus?
  toStatus   TicketStatus
  note       String?
  changedAt  DateTime      @default(now())

  @@index([ticketId])
}

enum MaintenanceFreq {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum MaintenanceMonthlyMode {
  DAY_OF_MONTH
  NTH_WEEKDAY
}

enum MaintenanceEndType {
  NEVER
  ON_DATE
  AFTER_COUNT
}

/// Regla de repeticion al estilo calendario: se repite cada `interval` `freq`.
/// Las ocurrencias se generan desde `createdAt` y el proximo vencimiento es la
/// primera posterior a la ultima vez que se hizo. Nada de esto se persiste.
model MaintenanceTask {
  id          String          @id @default(cuid())
  title       String
  description String?

  freq     MaintenanceFreq @default(DAY)
  interval Int             @default(1)

  /// Minutos desde la medianoche, hora de la clinica. Null solo cuando freq = HOUR.
  timeOfDay Int?
  /// Dias de la semana elegidos (0 = domingo .. 6 = sabado). Para freq = WEEK.
  weekdays  Int[]           @default([])

  /// Para freq = MONTH: por numero de dia, o por "el N-esimo <dia> del mes".
  monthlyMode MaintenanceMonthlyMode?
  /// Dia del mes (1..31, se recorta al ultimo dia). Para MONTH/DAY_OF_MONTH y YEAR.
  monthDay    Int?
  /// 1..4, o 5 = "el ultimo". Para MONTH/NTH_WEEKDAY (el dia sale de weekdays[0]).
  nthWeek     Int?
  /// Mes del anio (0 = enero .. 11 = diciembre). Para freq = YEAR.
  monthOfYear Int?

  endType  MaintenanceEndType @default(NEVER)
  endDate  DateTime?
  /// Cantidad de veces que hay que hacerla antes de darla por terminada.
  endCount Int?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  completions MaintenanceCompletion[]

  @@index([assetId])
}

model MaintenanceCompletion {
  id          String          @id @default(cuid())
  taskId      String
  task        MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note        String?
  completedAt DateTime        @default(now())

  @@index([taskId])
}

enum AssetType {
  PC
  NOTEBOOK
  PRINTER
  SERVER
  NETWORK
  UPS
  PHONE
  OTHER
}

enum AssetStatus {
  ACTIVE
  REPAIR
  RETIRED
}

/// Un equipo del inventario. Los tickets y las tareas periodicas se le cuelgan,
/// asi se puede ver todo lo que paso con un equipo en un solo lugar.
model Asset {
  id            String      @id @default(cuid())
  code          Int         @unique @default(autoincrement())
  name          String
  type          AssetType   @default(OTHER)
  brand         String?
  model         String?
  serialNumber  String?
  location      String?
  status        AssetStatus @default(ACTIVE)
  purchasedAt   DateTime?
  warrantyUntil DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tickets          Ticket[]
  maintenanceTasks MaintenanceTask[]

  @@index([status])
  @@index([type])
}
