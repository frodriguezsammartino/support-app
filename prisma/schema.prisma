generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  BACKLOG
  IN_PROGRESS
  /// Se llamó o se le pidió algo a un proveedor y se espera su respuesta.
  WAITING_PROVIDER
  COMPLETED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  active  Boolean  @default(true)
  /// Al cargar un ticket de esta categoría, pregunta qué equipo es.
  askAsset    Boolean @default(false)
  /// Al cargar un ticket de esta categoría, pregunta qué proveedor es (y lo escala).
  askProvider Boolean @default(false)
  tickets Ticket[]
}

model Ticket {
  id             String          @id @default(cuid())
  number         Int             @unique @default(autoincrement())
  reporterName   String
  reporterEmail  String?
  title          String
  description    String
  status         TicketStatus    @default(BACKLOG)
  priority       TicketPriority?
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  assetId        String?
  asset          Asset?          @relation(fields: [assetId], references: [id])
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  comments      Comment[]
  statusHistory TicketStatusHistory[]
  /// Pedidos de cambio, mejora o reemplazo que salieron de este ticket.
  requests      Request[]

  /// Escalamiento a un proveedor externo. Es una etiqueta aparte del estado del
  /// ticket: un ticket escalado sigue "en progreso", solo que se espera una respuesta.
  providerId        String?
  provider          Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  escalationStatus  EscalationStatus?
  /// Con quién se habla en el proveedor. Arranca con el contacto del proveedor.
  escalationContact String?
  /// El número de reclamo o caso del lado del proveedor.
  escalationRef     String?
  escalatedAt       DateTime?

  @@index([status])
  @@index([categoryId])
  @@index([reporterEmail])
  @@index([assetId])
  @@index([providerId])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  isFromAdmin Boolean @default(false)
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketStatusHistory {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus TicketStatus?
  toStatus   TicketStatus
  note       String?
  changedAt  DateTime      @default(now())

  @@index([ticketId])
}

enum MaintenanceFreq {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum MaintenanceMonthlyMode {
  DAY_OF_MONTH
  NTH_WEEKDAY
}

enum MaintenanceEndType {
  NEVER
  ON_DATE
  AFTER_COUNT
}

/// Regla de repeticion al estilo calendario: se repite cada `interval` `freq`.
/// Las ocurrencias se generan desde `createdAt` y el proximo vencimiento es la
/// primera posterior a la ultima vez que se hizo. Nada de esto se persiste.
model MaintenanceTask {
  id          String          @id @default(cuid())
  title       String
  description String?

  freq     MaintenanceFreq @default(DAY)
  interval Int             @default(1)

  /// Minutos desde la medianoche, hora de la clinica. Null solo cuando freq = HOUR.
  timeOfDay Int?
  /// Dias de la semana elegidos (0 = domingo .. 6 = sabado). Para freq = WEEK.
  weekdays  Int[]           @default([])

  /// Para freq = MONTH: por numero de dia, o por "el N-esimo <dia> del mes".
  monthlyMode MaintenanceMonthlyMode?
  /// Dia del mes (1..31, se recorta al ultimo dia). Para MONTH/DAY_OF_MONTH y YEAR.
  monthDay    Int?
  /// 1..4, o 5 = "el ultimo". Para MONTH/NTH_WEEKDAY (el dia sale de weekdays[0]).
  nthWeek     Int?
  /// Mes del anio (0 = enero .. 11 = diciembre). Para freq = YEAR.
  monthOfYear Int?

  endType  MaintenanceEndType @default(NEVER)
  endDate  DateTime?
  /// Cantidad de veces que hay que hacerla antes de darla por terminada.
  endCount Int?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  completions MaintenanceCompletion[]
  requests    Request[]

  @@index([assetId])
}

/// El log de una tarea periodica. DONE = se hizo (mueve lastCompletedAt);
/// NOTE = una observacion suelta que no cuenta como realizacion.
model MaintenanceCompletion {
  id          String             @id @default(cuid())
  taskId      String
  task        MaintenanceTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind        MaintenanceLogKind @default(DONE)
  note        String?
  completedAt DateTime           @default(now())

  @@index([taskId])
}

enum MaintenanceLogKind {
  DONE
  NOTE
}

enum AssetType {
  PC
  NOTEBOOK
  PRINTER
  SERVER
  NETWORK
  UPS
  PHONE
  OTHER
}

enum AssetStatus {
  /// Asignado y funcionando.
  ACTIVE
  /// En el deposito, sin asignar a nadie.
  STOCK
  /// En reparacion.
  REPAIR
}

/// Un equipo del inventario. Los tickets y las tareas periodicas se le cuelgan,
/// asi se puede ver todo lo que paso con un equipo en un solo lugar.
model Asset {
  id            String      @id @default(cuid())
  code          Int         @unique @default(autoincrement())
  name          String
  type          AssetType   @default(OTHER)
  brand         String?
  model         String?
  serialNumber  String?
  location      String?
  /// Persona a cargo. Solo aplica a equipos personales (PC, notebook).
  owner         String?
  /// Sistema operativo y ofimática instalados (PC, notebook, servidor). Texto
  /// libre; el catálogo de src/lib/os.ts dice cuáles ya no tienen soporte.
  os            String?
  office        String?
  status        AssetStatus @default(ACTIVE)
  purchasedAt   DateTime?
  warrantyUntil DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tickets          Ticket[]
  maintenanceTasks MaintenanceTask[]
  requests         Request[]
  components       AssetComponent[]

  @@index([status])
  @@index([type])
}

/// Una pieza de un equipo (procesador, RAM, disco, fuente, monitor...). Texto
/// libre: lo importante es saber qué tiene cada PC para pedir una mejora o un
/// cambio sin tener que abrirla.
model AssetComponent {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Del catálogo de src/lib/components.ts (RAM, DISCO...), o texto libre.
  kind        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assetId])
}

enum LicenseBilling {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum LicenseStatus {
  ACTIVE
  CANCELLED
}

/// Que clase de gasto es. Todo convive en la misma tabla para poder ver el
/// total de IT de una sola vez, pero se puede filtrar y subtotalizar.
enum LicenseKind {
  /// Licencia de software.
  SOFTWARE
  /// Servicio contratado: internet, telefonia, hosting, dominio.
  SERVICE
  /// Soporte o mantenimiento contratado a un tercero.
  SUPPORT
  OTHER
}

enum LicensePricing {
  /// Se paga por cada puesto: un puesto sin usar es plata tirada.
  PER_SEAT
  /// Precio cerrado por un paquete de puestos: sobran pero no cuestan de mas.
  FLAT
  /// Suscripcion sin limite de usuarios: no hay puestos que contar.
  UNLIMITED
}

/// Una licencia de software contratada: Office, antivirus, el dominio, etc.
/// `seats` son los puestos: cuantos se pagan y cuantos estan asignados.
model License {
  id     String      @id @default(cuid())
  code   Int         @unique @default(autoincrement())
  name   String
  kind   LicenseKind @default(SOFTWARE)
  vendor String?

  seatsTotal    Int @default(1)
  seatsAssigned Int @default(0)

  /// En centavos, para no arrastrar errores de redondeo con los decimales.
  /// Con PER_SEAT es el precio de un puesto; con FLAT es el total del paquete.
  costCents Int?
  currency  String         @default("ARS")
  billing   LicenseBilling @default(YEARLY)
  /// FLAT por defecto: es lo que significaba costCents antes de existir este campo.
  pricing   LicensePricing @default(FLAT)

  /// Proximo vencimiento o fecha de cobro. Con autoRenew se usa como ancla
  /// para proyectar los pagos siguientes.
  expiresAt DateTime?
  /// Se renueva y cobra sola: no hay que hacer nada al vencer.
  autoRenew Boolean       @default(false)
  status    LicenseStatus @default(ACTIVE)
  notes     String?
  /// Portal del proveedor, contrato o panel de administración.
  url       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests Request[]

  @@index([status])
}

enum RequestKind {
  /// El técnico pide dar de baja un equipo, licencia/servicio o tarea periódica.
  RETIRE
  /// Mejorar algo que anda (ampliar la RAM, cambiar el disco por uno más rápido).
  UPGRADE
  /// Cambiar algo roto: el mouse, el monitor, una fuente. Va por el mismo flujo.
  CHANGE
  /// Reemplazar el equipo entero; `items` lleva los componentes mínimos necesarios.
  REPLACE
  /// Comprar cosas del día a día (cables, insumos) para que quede registrado.
  PURCHASE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Una solicitud del técnico al administrador. El técnico no borra nada ni gasta
/// plata por su cuenta: pide, y el admin decide. Una mejora aprobada con costo es
/// el gasto de mantenimiento que se ve en el panel de Licencias y Servicios.
model Request {
  id     String        @id @default(cuid())
  number Int           @unique @default(autoincrement())
  kind   RequestKind
  status RequestStatus @default(PENDING)

  /// A qué se refiere. SetNull: si después se borra el objeto, la solicitud queda
  /// como historial gracias a targetLabel.
  assetId   String?
  asset     Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  licenseId String?
  license   License?         @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  taskId    String?
  task      MaintenanceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// El ticket desde el que se pidió, si salió de una reparación.
  ticketId  String?
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// Nombre del objeto al momento de pedir.
  targetLabel String

  title     String
  /// De qué pieza se trata, si se pidió desde un componente del equipo.
  component String?
  reason    String @default("")
  /// Lo que hace falta, en líneas de texto libre: [{ "text": "RAM 8 GB", "qty": 1 }].
  /// En un reemplazo son los componentes mínimos; en una compra, lo que se compra.
  items     Json?

  /// Lo que estima el técnico (opcional) y lo que fija el admin al aprobar.
  estimatedCostCents Int?
  costCents          Int?
  currency           String @default("ARS")

  requestedBy  String
  createdAt    DateTime  @default(now())
  /// Cuándo se resolvió. Para una mejora aprobada es la fecha del gasto.
  decidedAt    DateTime?
  decisionNote String?

  @@index([status])
  @@index([kind, status])
  @@index([assetId])
  @@index([licenseId])
  @@index([taskId])
  @@index([ticketId])
}

enum EscalationStatus {
  /// Se le avisó al proveedor y se espera su respuesta.
  WAITING
  /// El proveedor ya lo está trabajando.
  IN_PROGRESS
  /// El proveedor lo resolvió.
  RESOLVED
}

/// Un proveedor externo: quién es, qué cubre y con quién se habla. Los tickets se
/// pueden escalar a uno de ellos.
model Provider {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Qué sistema o servicio le compramos o nos da soporte.
  covers      String?
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
}
