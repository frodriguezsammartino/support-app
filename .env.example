# Connection strings de Neon (Dashboard > Connection Details)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Hash bcrypt de la contraseña del panel admin, codificado en base64
# (así se evita que el "$" del hash sea interpretado como variable en .env)
ADMIN_PASSWORD_HASH_B64="..."

# Secreto para firmar la cookie de sesión del admin (string aleatorio largo)
ADMIN_SESSION_SECRET="..."

# Resend (envío de emails) - OPCIONAL. Si no se configura, la app funciona
# igual y solo se salta el envío del email de resolución (queda un aviso en
# los logs). Se puede agregar más adelante sin tocar código.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Soporte Tecnico <onboarding@resend.dev>"

# Contraseña del técnico (mismo formato que la del admin: hash bcrypt en base64).
# El técnico entra por la misma pantalla de login; puede cargar y editar pero no
# borrar ni ver el dashboard. OPCIONAL: si falta, solo entra el admin.
TECH_PASSWORD_HASH_B64="..."
# Nombre con el que firma lo que carga el técnico (por defecto "Alfonso Araujo").
TECH_NAME="Alfonso Araujo"
